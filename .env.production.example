JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Shared database inside Docker network
DATABASE_URL=postgresql://delices_user:delices_password@postgres:5432/delices_db

# External service keys
GOOGLE_MAPS_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
FRONTEND_URL=http://180.149.199.203

# Public URLs used by the app in production
UPLOAD_PUBLIC_BASE_URL=https://api-delices.your-domain.com
NEXT_PUBLIC_AUTH_API=https://api-delices.your-domain.com
NEXT_PUBLIC_USER_API=https://api-delices.your-domain.com
NEXT_PUBLIC_RESTAURANT_API=https://api-delices.your-domain.com
NEXT_PUBLIC_ORDER_API=https://api-delices.your-domain.com
NEXT_PUBLIC_DELIVERY_API=https://api-delices.your-domain.com
NEXT_PUBLIC_PAYMENT_API=https://api-delices.your-domain.com
NEXT_PUBLIC_NOTIFICATION_API=https://api-delices.your-domain.com
NEXT_PUBLIC_GEOLOCATION_API=https://api-delices.your-domain.com
NEXT_PUBLIC_CHAT_API=https://api-delices.your-domain.com
NEXT_PUBLIC_UPLOAD_API=https://api-delices.your-domain.com
NEXT_PUBLIC_STRIPE_API=https://api-delices.your-domain.com
NEXT_PUBLIC_SMS_API=https://api-delices.your-domain.com
NEXT_PUBLIC_ORDER_WS=https://order-ws.your-domain.com
NEXT_PUBLIC_DELIVERY_WS=https://delivery-ws.your-domain.com
NEXT_PUBLIC_CHAT_WS=https://chat-ws.your-domain.com

# Admin dashboard tuning
ADMIN_MONTHLY_GOAL=500000
ADMIN_AVG_COMMISSION_PERCENT=22

# Optional JWT rotation and refresh settings
JWT_SECRET_OLD=
JWT_REFRESH_SECRET=
JWT_REFRESH_SECRET_OLD=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
