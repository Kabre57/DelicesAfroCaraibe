FROM node:lts-alpine

WORKDIR /usr/src/app

ARG NEXT_PUBLIC_AUTH_API
ARG NEXT_PUBLIC_USER_API
ARG NEXT_PUBLIC_RESTAURANT_API
ARG NEXT_PUBLIC_ORDER_API
ARG NEXT_PUBLIC_DELIVERY_API
ARG NEXT_PUBLIC_PAYMENT_API
ARG NEXT_PUBLIC_NOTIFICATION_API
ARG NEXT_PUBLIC_GEOLOCATION_API
ARG NEXT_PUBLIC_CHAT_API
ARG NEXT_PUBLIC_UPLOAD_API
ARG NEXT_PUBLIC_STRIPE_API
ARG NEXT_PUBLIC_SMS_API
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_ORDER_WS
ARG NEXT_PUBLIC_DELIVERY_WS
ARG NEXT_PUBLIC_CHAT_WS

ENV NEXT_PUBLIC_AUTH_API=$NEXT_PUBLIC_AUTH_API
ENV NEXT_PUBLIC_USER_API=$NEXT_PUBLIC_USER_API
ENV NEXT_PUBLIC_RESTAURANT_API=$NEXT_PUBLIC_RESTAURANT_API
ENV NEXT_PUBLIC_ORDER_API=$NEXT_PUBLIC_ORDER_API
ENV NEXT_PUBLIC_DELIVERY_API=$NEXT_PUBLIC_DELIVERY_API
ENV NEXT_PUBLIC_PAYMENT_API=$NEXT_PUBLIC_PAYMENT_API
ENV NEXT_PUBLIC_NOTIFICATION_API=$NEXT_PUBLIC_NOTIFICATION_API
ENV NEXT_PUBLIC_GEOLOCATION_API=$NEXT_PUBLIC_GEOLOCATION_API
ENV NEXT_PUBLIC_CHAT_API=$NEXT_PUBLIC_CHAT_API
ENV NEXT_PUBLIC_UPLOAD_API=$NEXT_PUBLIC_UPLOAD_API
ENV NEXT_PUBLIC_STRIPE_API=$NEXT_PUBLIC_STRIPE_API
ENV NEXT_PUBLIC_SMS_API=$NEXT_PUBLIC_SMS_API
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_ORDER_WS=$NEXT_PUBLIC_ORDER_WS
ENV NEXT_PUBLIC_DELIVERY_WS=$NEXT_PUBLIC_DELIVERY_WS
ENV NEXT_PUBLIC_CHAT_WS=$NEXT_PUBLIC_CHAT_WS

COPY ["package.json", "package-lock.json*", "npm-shrinkwrap.json*", "./"]
# Installer toutes les dépendances (dev incluses) pour pouvoir builder
RUN npm install

COPY . .
# Build Next.js en production (forcer webpack pour éviter Turbopack)
ENV NEXT_FORCE_WEBPACK=1
RUN NEXT_FORCE_WEBPACK=1 npm run build

# Nettoyer les devDependencies pour l'image finale
RUN npm prune --production

EXPOSE 3000
ENV NODE_ENV=production
RUN chown -R node /usr/src/app
USER node
CMD ["npm", "start"]
